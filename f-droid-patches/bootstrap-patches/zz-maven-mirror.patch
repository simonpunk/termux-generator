--- a/packages/termux-am/build.sh
+++ b/packages/termux-am/build.sh
@@ -13,6 +13,14 @@
 _GRADLE_VERSION=8.10.2
 
 termux_step_post_get_source() {
+	# Maven Central and Google Maven are intermittently unreachable from CI.
+	# Add mirrors so Gradle dependency resolution can use another host.
+	local gradle_file
+	for gradle_file in "$TERMUX_PKG_SRCDIR/build.gradle"; do
+		sed -i'' -e '/repositories {/a\
+        maven { url "https://maven.aliyun.com/repository/google" }\
+        maven { url "https://maven.aliyun.com/repository/public" }' "$gradle_file"
+	done
 	. "$TERMUX_SCRIPTDIR/scripts/termux_generator_utils.sh"
 	replace_termux_name "$TERMUX_PKG_SRCDIR" "$TERMUX_APP__PACKAGE_NAME"
 	migrate_termux_folder_tree "$TERMUX_PKG_SRCDIR" "$TERMUX_APP__PACKAGE_NAME"
