+# The Codeberg source archive is very slow/unreliable from CI. Ncurses only
+# needs foot.info to generate the foot terminfo entries, so fetch that file
+# directly instead of the whole archive.
+termux_step_post_get_source() {
+	mkdir -p "$TERMUX_PKG_SRCDIR/foot"
+	termux_download \
+		"https://codeberg.org/dnkl/foot/raw/tag/1.28.0/foot.info" \
+		"$TERMUX_PKG_TMPDIR/foot.info" \
+		40a23508a2ab5c9eadf979ec639b51805440d0c0a322cfee54c9b48e456b8a41
+	cp "$TERMUX_PKG_TMPDIR/foot.info" "$TERMUX_PKG_SRCDIR/foot/foot.info"
+}
